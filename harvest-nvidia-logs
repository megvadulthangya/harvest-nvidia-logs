#!/usr/bin/env python3
"""
harvest-nvidia-logs
===================

Collect and noise-filter `make.log` files produced by DKMS when building
the legacy NVIDIA 340xx / 390xx (and future) driver branches against
multiple Manjaro kernels.

Install::

    sudo install -m 755 harvest-nvidia-logs /usr/local/bin/harvest-nvidia-logs

No external dependencies — Python 3.10+ stdlib only.
"""

from __future__ import annotations

import argparse
import os
import re
import sys
from collections import Counter, defaultdict
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path


__version__ = "0.1.1"


# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

DEFAULT_HEADER_LINES = 10
DEFAULT_DIAG_ROOT = Path.home() / "diag"
DEFAULT_HARVEST_SUBDIR = "harvest"

# Warning signatures considered "known noise" from the kernel build system
# (mostly objtool on legacy NVIDIA binary blobs). Applied AFTER normalization,
# so patterns match the normalized form (paths stripped, symbols collapsed).
NOISE_PATTERNS: list[re.Pattern[str]] = [
    re.compile(r"warning: objtool:.*data relocation to !ENDBR"),
    re.compile(r"warning: objtool:.*relocation to !ENDBR"),
    re.compile(r"warning: objtool:.*'naked' return found in (?:MITIGATION_)?RETHUNK build"),
    re.compile(r"warning: objtool:.*missing int3 after ret"),
    re.compile(r"warning: objtool:.*unannotated intra-function call"),
    re.compile(r"warning: objtool:.*return with modified stack frame"),
    re.compile(r"warning: objtool:.*unreachable instruction"),
    re.compile(r"warning: objtool:.*sibling call from callable instruction"),
    re.compile(r"warning: objtool:.*call to __fentry__"),
    re.compile(r"warning: objtool:.*stack state mismatch"),
]

# --- Normalization regexes -------------------------------------------------
# Greedy match: drop everything up to the LAST "warning:" so embedded
# "warning:" fragments from concatenated log lines don't survive.
RE_BEFORE_WARNING = re.compile(r"^.*(?=warning:)")

# Only treat quoted strings that look like absolute paths as paths,
# otherwise 'naked' / 'warn_unused_result' would be replaced too.
RE_QUOTED_PATH = re.compile(r"'/[^']*'")

# Single-pass address normalizer: "symbol+0xHEX" -> "<func>+0xADDR",
# bare "0xHEX" -> "0xADDR". Done in one sub() so the replacement text
# "0xADDR" is never re-scanned (which previously produced "0xADDRR").
RE_ADDR = re.compile(
    r"(?P<sym>[.A-Za-z_][\w.]*\+0x[0-9a-fA-F]+)"
    r"|(?P<hex>0x[0-9a-fA-F]+)"
)

# An "error" line worth capturing. Deliberately conservative: matches
# compiler errors, linker errors, make aborts.
ERROR_RE = re.compile(
    r"(: error:|Error [0-9]+|\*\*\* \[|undefined reference to|ld: cannot)"
)


# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------

@dataclass
class BuildResult:
    branch: str
    variant: str
    build_name: str
    build_dir: Path
    out_dir: Path
    kernel_ver: str | None
    driver_ver: str | None
    log_path: Path | None
    log_size: int = 0
    log_lines: int = 0
    status: str = "unknown"
    err_count: int = 0
    noise_total: int = 0
    noise_uniq: int = 0
    clean_total: int = 0
    clean_uniq: int = 0
    clean_signatures: Counter[str] = field(default_factory=Counter)
    noise_signatures: Counter[str] = field(default_factory=Counter)
    error_excerpt: list[str] = field(default_factory=list)


# ---------------------------------------------------------------------------
# Normalization
# ---------------------------------------------------------------------------

def _addr_sub(m: re.Match) -> str:
    return "<func>+0xADDR" if m.group("sym") else "0xADDR"


def normalize_warning(line: str) -> str:
    """Collapse a raw warning line into a stable, groupable signature."""
    line = line.rstrip("\r\n")

    # 1. Drop everything before the LAST "warning:" (path prefix, embedded
    #    fragments from concatenated lines).
    m = RE_BEFORE_WARNING.match(line)
    if m:
        line = line[m.end():]

    # 2. Replace only absolute quoted paths with '<path>'. This keeps
    #    'naked' and other quoted keywords intact so noise patterns can
    #    still match them.
    line = RE_QUOTED_PATH.sub("'<path>'", line)

    # 3. One-pass address normalization.
    line = RE_ADDR.sub(_addr_sub, line)

    return line.strip()


def is_noise(signature: str) -> bool:
    return any(p.search(signature) for p in NOISE_PATTERNS)


# ---------------------------------------------------------------------------
# Discovery
# ---------------------------------------------------------------------------

def find_builds(diag_root: Path) -> list[tuple[str, str, Path]]:
    """Return (branch_label, variant, build_dir) for every build found."""
    results: list[tuple[str, str, Path]] = []
    for branch_dir in sorted(diag_root.glob("nvidia-*")):
        if not branch_dir.is_dir():
            continue
        branch = branch_dir.name[len("nvidia-"):]

        for variant, sub in (("normal", "normal-kernels"),
                              ("rt",     "rt-kernels")):
            var_root = branch_dir / sub
            if not var_root.is_dir():
                continue
            for build_dir in sorted(var_root.iterdir()):
                if build_dir.is_dir() and build_dir.name.startswith("linux"):
                    results.append((branch, variant, build_dir))
    return results


def find_make_log(build_dir: Path) -> Path | None:
    src = build_dir / "src"
    if not src.is_dir():
        return None
    for p in src.rglob("make.log"):
        if p.is_file():
            return p
    return None


def extract_versions(log_path: Path) -> tuple[str | None, str | None]:
    """Return (kernel_ver, driver_ver) from a path like
    .../src/nvidia/<driver>/<kernel>/x86_64/log/make.log
    """
    kernel = log_path.parent.parent.parent.name
    driver = log_path.parent.parent.parent.parent.name
    if kernel in ("src", "nvidia", "build", ""):
        return None, None
    return kernel, driver


# ---------------------------------------------------------------------------
# Per-build processing
# ---------------------------------------------------------------------------

def _write_counter(path: Path, counter: Counter[str]) -> None:
    lines = [f"{count:>8}  {sig}" for sig, count in counter.most_common()]
    path.write_text("\n".join(lines) + ("\n" if lines else ""))


def _write_summary(r: BuildResult) -> None:
    out: list[str] = []
    out.append(f"build:           {r.build_name}")
    out.append(f"driver:          {r.branch}")
    out.append(f"variant:         {r.variant}")
    out.append(f"kernel:          {r.kernel_ver or 'unknown'}")
    out.append(f"nvidia version:  {r.driver_ver or 'unknown'}")
    out.append(f"status:          {r.status}")
    out.append(f"log path:        {r.log_path if r.log_path else '(none)'}")
    if r.log_path:
        out.append(f"log size:        {r.log_size} bytes")
        out.append(f"log lines:       {r.log_lines}")
    out.append(f"build dir:       {r.build_dir}")
    out.append("")
    out.append(f"errors:          {r.err_count}")
    out.append(f"warnings clean:  {r.clean_total}  (unique: {r.clean_uniq})")
    out.append(f"warnings noise:  {r.noise_total}  (unique: {r.noise_uniq})")

    if r.clean_signatures:
        out.append("")
        out.append("=== Top clean warning groups ===")
        for sig, count in r.clean_signatures.most_common(25):
            out.append(f"{count:>8}  {sig}")

    if r.error_excerpt:
        out.append("")
        out.append("=== Error excerpt (first 20) ===")
        out.extend(r.error_excerpt)

    (r.out_dir / "summary.txt").write_text("\n".join(out) + "\n")


def process_build(
    branch: str,
    variant: str,
    build_dir: Path,
    harvest_root: Path,
    header_lines: int,
    quiet: bool = False,
) -> BuildResult:
    build_name = build_dir.name
    log_path = find_make_log(build_dir)
    kernel_ver, driver_ver = (None, None)
    if log_path is not None:
        kernel_ver, driver_ver = extract_versions(log_path)

    leaf = kernel_ver or build_name
    out_dir = harvest_root / branch / variant / leaf
    out_dir.mkdir(parents=True, exist_ok=True)

    result = BuildResult(
        branch=branch,
        variant=variant,
        build_name=build_name,
        build_dir=build_dir,
        out_dir=out_dir,
        kernel_ver=kernel_ver,
        driver_ver=driver_ver,
        log_path=log_path,
    )

    # --- not-built case --------------------------------------------------
    if log_path is None:
        result.status = "not-built"
        (out_dir / "Not-built").write_text("")
        _write_summary(result)
        _log(f"not-built: {branch}/{variant}/{build_name}", quiet)
        return result

    # --- stats -----------------------------------------------------------
    result.log_size = log_path.stat().st_size

    header_lines_list: list[str] = []
    error_lines: list[tuple[int, str]] = []
    clean_counter: Counter[str] = Counter()
    noise_counter: Counter[str] = Counter()
    line_no = 0

    with log_path.open("r", encoding="utf-8", errors="replace") as f:
        for raw in f:
            line_no += 1
            line = raw.rstrip("\r\n")

            if line_no <= header_lines:
                header_lines_list.append(line)

            if ERROR_RE.search(line):
                error_lines.append((line_no, line))

            if "warning:" in line:
                sig = normalize_warning(line)
                if sig:
                    if is_noise(sig):
                        noise_counter[sig] += 1
                    else:
                        clean_counter[sig] += 1

    result.log_lines = line_no
    result.err_count = len(error_lines)
    result.error_excerpt = [f"{i}: {ln}" for i, ln in error_lines[:20]]
    result.clean_signatures = clean_counter
    result.noise_signatures = noise_counter
    result.clean_total = sum(clean_counter.values())
    result.clean_uniq = len(clean_counter)
    result.noise_total = sum(noise_counter.values())
    result.noise_uniq = len(noise_counter)

    # --- write per-build files ------------------------------------------
    (out_dir / "00-header.txt").write_text(
        "\n".join(header_lines_list) + ("\n" if header_lines_list else "")
    )
    (out_dir / "01-errors.txt").write_text(
        "".join(f"{i}: {ln}\n" for i, ln in error_lines)
    )
    _write_counter(out_dir / "02-warnings.txt", clean_counter)
    _write_counter(out_dir / "03-noise.txt", noise_counter)

    # --- status ----------------------------------------------------------
    if result.err_count > 0:
        result.status = "failed"
    elif result.clean_total > 0:
        result.status = "warnings"
    else:
        result.status = "clean"

    _write_summary(result)
    _log(
        f"{branch}/{variant}/{build_name}  kernel={kernel_ver or '?'}  "
        f"status={result.status}  "
        f"({result.log_lines} lines / {result.log_size} B)",
        quiet,
    )
    return result


# ---------------------------------------------------------------------------
# INDEX.md generation
# ---------------------------------------------------------------------------

def _branch_list(branches: set[str]) -> str:
    return ", ".join(sorted(branches))


def generate_index(
    results: list[BuildResult],
    diag_root: Path,
    harvest_root: Path,
) -> None:
    idx_path = harvest_root / "INDEX.md"

    by_status = Counter(r.status for r in results)

    sig_map: dict[str, list[tuple[BuildResult, int]]] = defaultdict(list)
    for r in results:
        for sig, count in r.clean_signatures.items():
            sig_map[sig].append((r, count))

    multi: list[tuple[str, int, int, set[str]]] = []
    single: list[tuple[str, BuildResult, int]] = []

    for sig, occurrences in sig_map.items():
        builds = len(occurrences)
        hits = sum(c for _, c in occurrences)
        combos = {f"{r.branch}/{r.variant}" for r, _ in occurrences}
        if builds > 1:
            multi.append((sig, builds, hits, combos))
        else:
            single.append((sig, occurrences[0][0], occurrences[0][1]))

    multi.sort(key=lambda x: (-x[1], -x[2], x[0]))
    single.sort(key=lambda x: (-x[2], x[0]))

    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S %z")
    out: list[str] = []
    A = out.append

    A(f"# Harvest Index — {now}")
    A("")

    # --- Overview --------------------------------------------------------
    A("## Overview")
    A("")
    A(f"- **Diag root:** `{diag_root}`")
    A(f"- **Harvest:**   `{harvest_root}`")
    A(f"- **Branches:**  {_branch_list({r.branch for r in results})}")
    A(
        f"- **Builds:** {len(results)} — "
        f"❗{by_status['failed']} failed, "
        f"⚠{by_status['warnings']} warn, "
        f"✅{by_status['clean']} clean, "
        f"🚫{by_status['not-built']} not-built"
    )
    A(
        f"- **Signatures:** {len(sig_map)} total — "
        f"{len(multi)} across multiple builds, "
        f"{len(single)} unique to one build"
    )
    A("")

    # --- Legend ----------------------------------------------------------
    A("## Legend")
    A("")
    A("| Symbol | Status | Meaning |")
    A("|:------:|--------|---------|")
    A("| ❗ | failed    | make.log exists, real errors found — **blocker** |")
    A("| ⚠  | warnings  | built, no errors, non-noise warnings to review |")
    A("| ✅ | clean     | built, no errors, only known noise |")
    A("| 🚫 | not-built | no make.log at all |")
    A("")
    A("Per-build detail lives in the harvest tree, one directory per kernel: "
      "`00-header.txt`, `01-errors.txt`, `02-warnings.txt`, `03-noise.txt`, "
      "`summary.txt`.")
    A("")

    # --- Status table ----------------------------------------------------
    A("## Status table")
    A("")
    A("| # | Branch | Variant | Kernel | Driver | Status | Err | Clean (uniq/total) | Noise |")
    A("|---|--------|---------|--------|--------|:------:|----:|-------------------:|------:|")
    sorted_results = sorted(
        results,
        key=lambda r: (r.branch, r.variant, r.kernel_ver or r.build_name),
    )
    for i, r in enumerate(sorted_results, 1):
        sym = {"failed": "❗", "warnings": "⚠", "clean": "✅",
               "not-built": "🚫"}.get(r.status, "?")
        kernel = r.kernel_ver or r.build_name
        driver = r.driver_ver or "-"
        A(
            f"| {i} | {r.branch} | {r.variant} | {kernel} | {driver} | "
            f"{sym} {r.status} | {r.err_count} | "
            f"{r.clean_uniq} / {r.clean_total} | {r.noise_total} |"
        )
    A("")

    # --- Failures --------------------------------------------------------
    failed = [r for r in results if r.status == "failed"]
    if failed:
        A("## ❗ Failures — fix these first")
        A("")
        A("Full error list in each build's `01-errors.txt`. Excerpt below.")
        A("")
        for r in failed:
            A(f"### {r.branch} / {r.variant} / {r.kernel_ver or r.build_name} "
              f"— {r.driver_ver or '?'}  ({r.err_count} errors)")
            A("")
            A(f"Path: `{r.out_dir.relative_to(harvest_root)}`")
            A("")
            A("```")
            for ln in r.error_excerpt[:15]:
                A(ln)
            A("```")
            A("")

    # --- Cross-build signatures -----------------------------------------
    A("## 🔁 Cross-build signatures")
    A("")
    A("Warnings appearing in **more than one build**. "
      "Fixing the top signature fixes the most builds at once.")
    A("")
    if multi:
        A("| # | Builds | Hits | Signature | Branches |")
        A("|---|-------:|-----:|-----------|----------|")
        for i, (sig, builds, hits, combos) in enumerate(multi, 1):
            A(f"| {i} | {builds} | {hits} | `{sig}` | {', '.join(sorted(combos))} |")
    else:
        A("_No cross-build signatures — every warning is unique to a single build._")
    A("")

    # --- Unique to one build --------------------------------------------
    A("## 🧩 Unique to one build")
    A("")
    A("Warnings in exactly **one** build. Usually kernel- or config-specific, "
      "not driver bugs.")
    A("")
    if single:
        A("| Build | Hits | Signature |")
        A("|-------|-----:|-----------|")
        for sig, r, hits in single:
            ident = f"{r.branch}/{r.variant}/{r.kernel_ver or r.build_name}"
            A(f"| {ident} | {hits} | `{sig}` |")
    else:
        A("_No unique-to-one-build warnings._")
    A("")

    # --- Not built -------------------------------------------------------
    not_built = [r for r in results if r.status == "not-built"]
    if not_built:
        A("## 🚫 Not built (no make.log)")
        A("")
        for r in not_built:
            A(f"- `{r.branch} / {r.variant} / {r.build_name}`")
        A("")

    A("---")
    A("_End of index. Per-build detail files live in the harvest tree._")

    idx_path.write_text("\n".join(out) + "\n")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _log(msg: str, quiet: bool) -> None:
    if not quiet:
        print(f"[harvest] {msg}", file=sys.stderr)


def _warn(msg: str) -> None:
    print(f"[harvest][warn] {msg}", file=sys.stderr)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="harvest-nvidia-logs",
        description="Collect and noise-filter nvidia driver make.logs "
                    "across multiple kernel builds.",
    )
    p.add_argument(
        "-d", "--diag-root",
        type=Path,
        default=Path(os.environ.get("DIAG_ROOT", str(DEFAULT_DIAG_ROOT))),
        help="Base diag directory (default: $HOME/diag, env DIAG_ROOT)",
    )
    p.add_argument(
        "-o", "--harvest-dir",
        type=Path,
        default=None,
        help="Output directory (default: <diag-root>/harvest)",
    )
    p.add_argument(
        "-n", "--header-lines",
        type=int,
        default=DEFAULT_HEADER_LINES,
        help=f"Lines from top of make.log to save (default: {DEFAULT_HEADER_LINES})",
    )
    p.add_argument(
        "-q", "--quiet",
        action="store_true",
        help="Suppress progress output on stderr",
    )
    p.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {__version__}",
    )
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    diag_root = args.diag_root.expanduser().resolve()
    harvest_root = (
        args.harvest_dir or (diag_root / DEFAULT_HARVEST_SUBDIR)
    ).expanduser().resolve()

    if not diag_root.is_dir():
        _warn(f"diag root does not exist: {diag_root}")
        return 1

    harvest_root.mkdir(parents=True, exist_ok=True)
    _log(f"DIAG_ROOT={diag_root}", args.quiet)
    _log(f"HARVEST_DIR={harvest_root}", args.quiet)

    builds = find_builds(diag_root)
    if not builds:
        _warn(f"no nvidia-* branch directory found under {diag_root}")
        return 0

    results: list[BuildResult] = []
    for branch, variant, build_dir in builds:
        try:
            r = process_build(
                branch, variant, build_dir,
                harvest_root, args.header_lines, args.quiet,
            )
            results.append(r)
        except Exception as e:
            _warn(f"failed to process {build_dir}: {e}")

    generate_index(results, diag_root, harvest_root)
    _log(f"Index: {harvest_root / 'INDEX.md'}", args.quiet)
    return 0


if __name__ == "__main__":
    sys.exit(main())