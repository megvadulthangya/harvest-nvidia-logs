#!/usr/bin/env python3
"""
harvest-nvidia-logs
===================

Collect and noise-filter `make.log` files produced by DKMS when building
the legacy NVIDIA 340xx / 390xx (and future) driver branches against
multiple Manjaro kernels.

Install::

    sudo install -m 755 harvest-nvidia-logs /usr/local/bin/harvest-nvidia-logs

No external dependencies — Python 3.10+ stdlib only.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from collections import Counter, defaultdict
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path


__version__ = "0.4.0"


# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

DEFAULT_HEADER_LINES = 10
DEFAULT_DIAG_ROOT = Path.home() / "diag"
DEFAULT_HARVEST_SUBDIR = "harvest"
DEFAULT_HISTORY_KEEP = 20

NOISE_PATTERNS: list[re.Pattern[str]] = [
    re.compile(r"warning: objtool:.*data relocation to !ENDBR"),
    re.compile(r"warning: objtool:.*relocation to !ENDBR"),
    re.compile(r"warning: objtool:.*'naked' return found in (?:MITIGATION_)?RETHUNK build"),
    re.compile(r"warning: objtool:.*missing int3 after ret"),
    re.compile(r"warning: objtool:.*unannotated intra-function call"),
    re.compile(r"warning: objtool:.*return with modified stack frame"),
    re.compile(r"warning: objtool:.*unreachable instruction"),
    re.compile(r"warning: objtool:.*sibling call from callable instruction"),
    re.compile(r"warning: objtool:.*call to __fentry__"),
    re.compile(r"warning: objtool:.*stack state mismatch"),
]

RE_BEFORE_WARNING = re.compile(r"^.*(?=warning:)")
RE_QUOTED_PATH = re.compile(r"'/[^']*'")
RE_ADDR = re.compile(
    r"(?P<sym>[.A-Za-z_][\w.]*\+0x[0-9a-fA-F]+)"
    r"|(?P<hex>0x[0-9a-fA-F]+)"
)

ERROR_RE = re.compile(
    r"(: error:|: fatal error:|Error [0-9]+|\*\*\* \["
    r"|undefined reference to|ld: cannot|No rule to make target)"
)

SUSPICIOUS_RE = re.compile(
    r"cannot find"
    r"|No such file or directory"
    r"|[Pp]ermission denied"
    r"|\bAborted\b"
    r"|\bKilled\b"
    r"|\bsegmentation fault\b"
    r"|\bcore dumped\b"
    r"|out of memory"
    r"|\bOOM\b"
    r"|\btimed? out\b"
    r"|[Mm]odule not found"
    r"|[Ss]ymbol not found"
    r"|missing .*\.h\b"
    r"|\bnot found\b"
)

LD_M_RE = re.compile(r"LD \[M\]\s+(\S+)")
MODPOST_MARKERS = ("MODPOST", "Building modules", "BTF [M]")
NOTHING_TO_DO_MARKERS = ("Nothing to be done", "is up to date")

TRUNCATION_LOG_THRESHOLD = 1_000_000


# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------

@dataclass
class BuildResult:
    branch: str
    variant: str
    build_name: str
    build_dir: Path
    out_dir: Path
    kernel_ver: str | None
    driver_ver: str | None
    log_path: Path | None
    log_size: int = 0
    log_lines: int = 0
    status: str = "unknown"
    err_count: int = 0
    noise_total: int = 0
    noise_uniq: int = 0
    clean_total: int = 0
    clean_uniq: int = 0
    suspicious_total: int = 0
    suspicious_uniq: int = 0
    clean_signatures: Counter[str] = field(default_factory=Counter)
    noise_signatures: Counter[str] = field(default_factory=Counter)
    suspicious_signatures: Counter[str] = field(default_factory=Counter)
    error_excerpt: list[str] = field(default_factory=list)
    suspicious_excerpt: list[str] = field(default_factory=list)
    integrity_issues: list[str] = field(default_factory=list)
    integrity_notes: list[str] = field(default_factory=list)
    modules_on_disk: list[str] = field(default_factory=list)
    log_ld_modules: set[str] = field(default_factory=set)
    log_has_modpost: bool = False
    log_nothing_to_do: bool = False


# ---------------------------------------------------------------------------
# Normalization
# ---------------------------------------------------------------------------

def _addr_sub(m: re.Match) -> str:
    return "<func>+0xADDR" if m.group("sym") else "0xADDR"


def normalize_warning(line: str) -> str:
    line = line.rstrip("\r\n")
    m = RE_BEFORE_WARNING.match(line)
    if m:
        line = line[m.end():]
    line = RE_QUOTED_PATH.sub("'<path>'", line)
    line = RE_ADDR.sub(_addr_sub, line)
    return line.strip()


def normalize_generic(line: str) -> str:
    line = line.rstrip("\r\n")
    line = RE_QUOTED_PATH.sub("'<path>'", line)
    line = RE_ADDR.sub(_addr_sub, line)
    line = re.sub(r"[ \t]+", " ", line)
    return line.strip()


def is_noise(signature: str) -> bool:
    return any(p.search(signature) for p in NOISE_PATTERNS)


# ---------------------------------------------------------------------------
# Discovery
# ---------------------------------------------------------------------------

def find_builds(diag_root: Path) -> list[tuple[str, str, Path]]:
    results: list[tuple[str, str, Path]] = []
    for branch_dir in sorted(diag_root.glob("nvidia-*")):
        if not branch_dir.is_dir():
            continue
        branch = branch_dir.name[len("nvidia-"):]
        for variant, sub in (("normal", "normal-kernels"),
                              ("rt",     "rt-kernels")):
            var_root = branch_dir / sub
            if not var_root.is_dir():
                continue
            for build_dir in sorted(var_root.iterdir()):
                if build_dir.is_dir() and build_dir.name.startswith("linux"):
                    results.append((branch, variant, build_dir))
    return results


def find_make_log(build_dir: Path) -> Path | None:
    src = build_dir / "src"
    if not src.is_dir():
        return None
    for p in src.rglob("make.log"):
        if p.is_file():
            return p
    return None


def extract_versions(log_path: Path) -> tuple[str | None, str | None]:
    kernel = log_path.parent.parent.parent.name
    driver = log_path.parent.parent.parent.parent.name
    if kernel in ("src", "nvidia", "build", ""):
        return None, None
    return kernel, driver


# ---------------------------------------------------------------------------
# Module artifact discovery
# ---------------------------------------------------------------------------

def _find_module_artifacts(build_dir: Path) -> list[str]:
    found: set[str] = set()
    for mod_dir in build_dir.rglob("module"):
        if not mod_dir.is_dir():
            continue
        for ko in mod_dir.glob("*.ko.zst"):
            found.add(ko.name[: -len(".ko.zst")])
        for ko in mod_dir.glob("*.ko"):
            found.add(ko.name[: -len(".ko")])
    for extramod in build_dir.rglob("extramodules"):
        if not extramod.is_dir():
            continue
        for ko in extramod.glob("*.ko.zst"):
            found.add(ko.name[: -len(".ko.zst")])
        for ko in extramod.glob("*.ko"):
            found.add(ko.name[: -len(".ko")])
    return sorted(found)


def _strip_module_suffix(target: str) -> str:
    base = target.rsplit("/", 1)[-1]
    for suffix in (".ko.zst", ".ko", ".o"):
        if base.endswith(suffix):
            return base[: -len(suffix)]
    return base


def _has_artifact_dirs(build_dir: Path) -> bool:
    if (build_dir / "pkg").is_dir():
        return True
    for name in ("module", "extramodules"):
        for d in build_dir.rglob(name):
            if d.is_dir():
                return True
    return False


# ---------------------------------------------------------------------------
# Integrity checks (log-aware)
# ---------------------------------------------------------------------------

def check_integrity(
    result: BuildResult, build_dir: Path,
) -> tuple[list[str], list[str], list[str]]:
    issues: list[str] = []
    notes: list[str] = []

    modules = _find_module_artifacts(build_dir)

    if result.log_ld_modules:
        if _has_artifact_dirs(build_dir):
            missing = sorted(m for m in result.log_ld_modules if m not in modules)
            if missing:
                issues.append(
                    "log claims to link modules "
                    f"{missing} but no matching .ko/.ko.zst found on disk"
                )
        else:
            notes.append(
                "log-only tree (no module/ or pkg/ dir); "
                "artifact check skipped"
            )

    if result.log_nothing_to_do:
        notes.append("log reports 'Nothing to be done' — build was cached")

    if (result.log_size > TRUNCATION_LOG_THRESHOLD
            and not result.log_has_modpost
            and not result.log_nothing_to_do):
        notes.append(
            "large log has no MODPOST / 'Building modules' marker — "
            "possibly truncated DKMS log"
        )

    return issues, notes, modules


# ---------------------------------------------------------------------------
# Per-build processing
# ---------------------------------------------------------------------------

def _write_counter(path: Path, counter: Counter[str]) -> None:
    lines = [f"{count:>8}  {sig}" for sig, count in counter.most_common()]
    path.write_text("\n".join(lines) + ("\n" if lines else ""))


def _write_summary(r: BuildResult) -> None:
    out: list[str] = []
    out.append(f"build:           {r.build_name}")
    out.append(f"driver:          {r.branch}")
    out.append(f"variant:         {r.variant}")
    out.append(f"kernel:          {r.kernel_ver or 'unknown'}")
    out.append(f"nvidia version:  {r.driver_ver or 'unknown'}")
    out.append(f"status:          {r.status}")
    out.append(f"log path:        {r.log_path if r.log_path else '(none)'}")
    if r.log_path:
        out.append(f"log size:        {r.log_size} bytes")
        out.append(f"log lines:       {r.log_lines}")
    out.append(f"build dir:       {r.build_dir}")
    out.append("")
    out.append(f"errors:          {r.err_count}")
    out.append(f"warnings clean:  {r.clean_total}  (unique: {r.clean_uniq})")
    out.append(f"warnings noise:  {r.noise_total}  (unique: {r.noise_uniq})")
    out.append(f"suspicious:      {r.suspicious_total}  (unique: {r.suspicious_uniq})")
    out.append(f"modules on disk: {len(r.modules_on_disk)}  "
               f"[{', '.join(r.modules_on_disk) if r.modules_on_disk else '—'}]")
    if r.log_ld_modules:
        out.append(f"log LD [M]:      {sorted(r.log_ld_modules)}")
    out.append(f"log MODPOST:     {'yes' if r.log_has_modpost else 'no'}")
    out.append(f"log cached:      {'yes' if r.log_nothing_to_do else 'no'}")

    if r.integrity_issues:
        out.append("")
        out.append("=== Integrity issues ===")
        for issue in r.integrity_issues:
            out.append(f"  ! {issue}")

    if r.integrity_notes:
        out.append("")
        out.append("=== Integrity notes ===")
        for note in r.integrity_notes:
            out.append(f"  · {note}")

    if r.clean_signatures:
        out.append("")
        out.append("=== Top clean warning groups ===")
        for sig, count in r.clean_signatures.most_common(25):
            out.append(f"{count:>8}  {sig}")

    if r.suspicious_signatures:
        out.append("")
        out.append("=== Suspicious groups ===")
        for sig, count in r.suspicious_signatures.most_common(25):
            out.append(f"{count:>8}  {sig}")

    if r.error_excerpt:
        out.append("")
        out.append("=== Error excerpt (first 20) ===")
        out.extend(r.error_excerpt)

    (r.out_dir / "summary.txt").write_text("\n".join(out) + "\n")


def process_build(
    branch: str,
    variant: str,
    build_dir: Path,
    harvest_root: Path,
    header_lines: int,
    quiet: bool = False,
) -> BuildResult:
    build_name = build_dir.name
    log_path = find_make_log(build_dir)
    kernel_ver, driver_ver = (None, None)
    if log_path is not None:
        kernel_ver, driver_ver = extract_versions(log_path)

    leaf = kernel_ver or build_name
    out_dir = harvest_root / branch / variant / leaf
    out_dir.mkdir(parents=True, exist_ok=True)

    result = BuildResult(
        branch=branch,
        variant=variant,
        build_name=build_name,
        build_dir=build_dir,
        out_dir=out_dir,
        kernel_ver=kernel_ver,
        driver_ver=driver_ver,
        log_path=log_path,
    )

    if log_path is None:
        result.status = "not-built"
        (out_dir / "Not-built").write_text("")
        _write_summary(result)
        _log(f"not-built: {branch}/{variant}/{build_name}", quiet)
        return result

    result.log_size = log_path.stat().st_size

    header_lines_list: list[str] = []
    error_lines: list[tuple[int, str]] = []
    clean_counter: Counter[str] = Counter()
    noise_counter: Counter[str] = Counter()
    suspicious_counter: Counter[str] = Counter()
    suspicious_lines: list[tuple[int, str]] = []
    line_no = 0

    with log_path.open("r", encoding="utf-8", errors="replace") as f:
        for raw in f:
            line_no += 1
            line = raw.rstrip("\r\n")

            if line_no <= header_lines:
                header_lines_list.append(line)

            if "LD [M]" in line:
                m = LD_M_RE.search(line)
                if m:
                    result.log_ld_modules.add(_strip_module_suffix(m.group(1)))
            if not result.log_has_modpost and any(
                marker in line for marker in MODPOST_MARKERS
            ):
                result.log_has_modpost = True
            if not result.log_nothing_to_do and any(
                marker in line for marker in NOTHING_TO_DO_MARKERS
            ):
                result.log_nothing_to_do = True

            if ERROR_RE.search(line):
                error_lines.append((line_no, line))
                continue

            if "warning:" in line:
                sig = normalize_warning(line)
                if sig:
                    if is_noise(sig):
                        noise_counter[sig] += 1
                    else:
                        clean_counter[sig] += 1
                continue

            if SUSPICIOUS_RE.search(line):
                sig = normalize_generic(line)
                if sig:
                    suspicious_counter[sig] += 1
                    if len(suspicious_lines) < 40:
                        suspicious_lines.append((line_no, line))

    result.log_lines = line_no
    result.err_count = len(error_lines)
    result.error_excerpt = [f"{i}: {ln}" for i, ln in error_lines[:20]]
    result.clean_signatures = clean_counter
    result.noise_signatures = noise_counter
    result.suspicious_signatures = suspicious_counter
    result.clean_total = sum(clean_counter.values())
    result.clean_uniq = len(clean_counter)
    result.noise_total = sum(noise_counter.values())
    result.noise_uniq = len(noise_counter)
    result.suspicious_total = sum(suspicious_counter.values())
    result.suspicious_uniq = len(suspicious_counter)
    result.suspicious_excerpt = [f"{i}: {ln}" for i, ln in suspicious_lines]

    result.integrity_issues, result.integrity_notes, result.modules_on_disk = (
        check_integrity(result, build_dir)
    )

    (out_dir / "00-header.txt").write_text(
        "\n".join(header_lines_list) + ("\n" if header_lines_list else "")
    )
    (out_dir / "01-errors.txt").write_text(
        "".join(f"{i}: {ln}\n" for i, ln in error_lines)
    )
    _write_counter(out_dir / "02-warnings.txt", clean_counter)
    _write_counter(out_dir / "03-noise.txt", noise_counter)
    _write_counter(out_dir / "04-suspicious.txt", suspicious_counter)

    if result.err_count > 0:
        result.status = "failed"
    elif result.integrity_issues or result.suspicious_total > 0:
        result.status = "suspicious"
    elif result.clean_total > 0:
        result.status = "warnings"
    else:
        result.status = "clean"

    _write_summary(result)

    extra = ""
    if result.integrity_issues:
        extra = f"  integrity={len(result.integrity_issues)}"
    _log(
        f"{branch}/{variant}/{build_name}  kernel={kernel_ver or '?'}  "
        f"status={result.status}{extra}  "
        f"({result.log_lines} lines / {result.log_size} B)",
        quiet,
    )
    return result


# ---------------------------------------------------------------------------
# Shared INDEX helpers
# ---------------------------------------------------------------------------

STATUS_SYMBOL = {
    "failed": "❗",
    "suspicious": "🔍",
    "warnings": "⚠",
    "clean": "✅",
    "not-built": "🚫",
}


def _branch_list(branches: set[str]) -> str:
    return ", ".join(sorted(branches))


def _build_key(r: BuildResult) -> str:
    return f"{r.branch}/{r.variant}/{r.kernel_ver or r.build_name}"


# ---------------------------------------------------------------------------
# History snapshot & diff
# ---------------------------------------------------------------------------

def _snapshot_state(results: list[BuildResult], timestamp: str) -> dict:
    builds: dict[str, dict] = {}
    sigs: dict[str, dict] = {}
    for r in results:
        key = _build_key(r)
        builds[key] = {
            "status": r.status,
            "err_count": r.err_count,
            "clean_uniq": r.clean_uniq,
            "clean_total": r.clean_total,
            "noise_total": r.noise_total,
            "suspicious_total": r.suspicious_total,
        }
        for sig, count in r.clean_signatures.items():
            entry = sigs.setdefault(sig, {"hits": 0, "builds": []})
            entry["hits"] += count
            entry["builds"].append(key)
    return {
        "timestamp": timestamp,
        "builds": builds,
        "clean_signatures": sigs,
    }


def _latest_snapshot(history_root: Path) -> tuple[str, dict] | None:
    if not history_root.is_dir():
        return None
    dirs = sorted(
        (d for d in history_root.iterdir() if d.is_dir()),
        reverse=True,
    )
    for d in dirs:
        state_file = d / "state.json"
        if state_file.is_file():
            try:
                data = json.loads(state_file.read_text())
                return d.name, data
            except (OSError, json.JSONDecodeError):
                continue
    return None


def _compute_diff(prev: dict, curr: dict) -> dict:
    prev_sigs: dict = prev.get("clean_signatures", {})
    curr_sigs: dict = curr.get("clean_signatures", {})

    new_sigs = sorted(set(curr_sigs) - set(prev_sigs))
    resolved_sigs = sorted(set(prev_sigs) - set(curr_sigs))

    changed_hits: list[tuple[str, int, int]] = []
    for sig in sorted(set(prev_sigs) & set(curr_sigs)):
        ph = prev_sigs[sig]["hits"]
        ch = curr_sigs[sig]["hits"]
        if ph != ch:
            changed_hits.append((sig, ph, ch))
    changed_hits.sort(key=lambda x: -abs(x[2] - x[1]))

    prev_builds: dict = prev.get("builds", {})
    curr_builds: dict = curr.get("builds", {})
    added_builds = sorted(set(curr_builds) - set(prev_builds))
    removed_builds = sorted(set(prev_builds) - set(curr_builds))
    status_changes: list[tuple[str, str, str]] = []
    for k in sorted(set(prev_builds) & set(curr_builds)):
        ps = prev_builds[k]["status"]
        cs = curr_builds[k]["status"]
        if ps != cs:
            status_changes.append((k, ps, cs))

    return {
        "prev_timestamp": prev.get("timestamp", "?"),
        "new_sigs": new_sigs,
        "resolved_sigs": resolved_sigs,
        "changed_hits": changed_hits,
        "added_builds": added_builds,
        "removed_builds": removed_builds,
        "status_changes": status_changes,
    }


def render_diff_section(diff: dict) -> list[str]:
    out: list[str] = []
    A = out.append

    A(f"## 📊 Changes since {diff['prev_timestamp']}")
    A("")

    A(f"### ✅ Resolved signatures ({len(diff['resolved_sigs'])})")
    A("")
    if diff["resolved_sigs"]:
        for sig in diff["resolved_sigs"]:
            A(f"- `{sig}`")
    else:
        A("_None._")
    A("")

    A(f"### 🆕 New signatures ({len(diff['new_sigs'])})")
    A("")
    if diff["new_sigs"]:
        for sig in diff["new_sigs"]:
            A(f"- `{sig}`")
    else:
        A("_None._")
    A("")

    A(f"### 🔀 Status changes ({len(diff['status_changes'])})")
    A("")
    if diff["status_changes"]:
        for build, ps, cs in diff["status_changes"]:
            A(
                f"- `{build}`: {STATUS_SYMBOL.get(ps, ps)} {ps} → "
                f"{STATUS_SYMBOL.get(cs, cs)} {cs}"
            )
    else:
        A("_None._")
    A("")

    if diff["changed_hits"]:
        A(f"### 📉 Changed hit counts ({len(diff['changed_hits'])})")
        A("")
        for sig, ph, ch in diff["changed_hits"][:20]:
            delta = ch - ph
            sign = "+" if delta > 0 else ""
            A(f"- `{sig}` — {ph} → {ch} ({sign}{delta})")
        A("")

    if diff["added_builds"]:
        A(f"### ➕ New builds ({len(diff['added_builds'])})")
        A("")
        for b in diff["added_builds"]:
            A(f"- `{b}`")
        A("")

    if diff["removed_builds"]:
        A(f"### ➖ Removed builds ({len(diff['removed_builds'])})")
        A("")
        for b in diff["removed_builds"]:
            A(f"- `{b}`")
        A("")

    return out


# ---------------------------------------------------------------------------
# Changelog (append-only, newest first)
# ---------------------------------------------------------------------------

CHANGELOG_HEADER = "# Driver Changelog\n\n"
CHANGELOG_SUBHEADER = (
    "Append-only log of harvest runs. Newest entries at the top. "
    "Generated by `harvest-nvidia-logs --diff --changelog`.\n\n"
)


def append_changelog(path: Path, diff_lines: list[str], timestamp: str) -> None:
    """Prepend a new entry to the changelog file (newest first)."""
    # Strip the leading "## 📊 Changes since …" header + blank line from
    # the diff section — we generate our own date heading.
    body = diff_lines
    if body and body[0].startswith("## 📊"):
        body = body[1:]
        if body and body[0] == "":
            body = body[1:]

    entry = [f"## {timestamp} UTC", ""] + body + ["", "---", ""]

    if path.is_file():
        existing = path.read_text()
        if existing.startswith(CHANGELOG_HEADER.strip("\n")):
            # Strip header + subheader, keep the rest
            marker = CHANGELOG_SUBHEADER
            if marker in existing:
                rest = existing.split(marker, 1)[1]
            else:
                rest = existing.split("\n\n", 1)[-1]
            new = CHANGELOG_HEADER + CHANGELOG_SUBHEADER + "\n".join(entry) + rest
        else:
            new = CHANGELOG_HEADER + CHANGELOG_SUBHEADER + "\n".join(entry) + existing
    else:
        new = CHANGELOG_HEADER + CHANGELOG_SUBHEADER + "\n".join(entry)

    path.write_text(new)


# ---------------------------------------------------------------------------
# INDEX.md
# ---------------------------------------------------------------------------

def generate_index(
    results: list[BuildResult],
    diag_root: Path,
    harvest_root: Path,
    diff_lines: list[str] | None = None,
) -> None:
    idx_path = harvest_root / "INDEX.md"
    by_status = Counter(r.status for r in results)

    sig_map: dict[str, list[tuple[BuildResult, int]]] = defaultdict(list)
    for r in results:
        for sig, count in r.clean_signatures.items():
            sig_map[sig].append((r, count))

    multi: list[tuple[str, int, int, set[str]]] = []
    single: list[tuple[str, BuildResult, int]] = []
    for sig, occurrences in sig_map.items():
        builds = len(occurrences)
        hits = sum(c for _, c in occurrences)
        combos = {f"{r.branch}/{r.variant}" for r, _ in occurrences}
        if builds > 1:
            multi.append((sig, builds, hits, combos))
        else:
            single.append((sig, occurrences[0][0], occurrences[0][1]))
    multi.sort(key=lambda x: (-x[1], -x[2], x[0]))
    single.sort(key=lambda x: (-x[2], x[0]))

    sus_map: dict[str, list[tuple[BuildResult, int]]] = defaultdict(list)
    for r in results:
        for sig, count in r.suspicious_signatures.items():
            sus_map[sig].append((r, count))

    sus_multi: list[tuple[str, int, int, set[str]]] = []
    for sig, occurrences in sus_map.items():
        builds = len(occurrences)
        hits = sum(c for _, c in occurrences)
        combos = {f"{r.branch}/{r.variant}" for r, _ in occurrences}
        sus_multi.append((sig, builds, hits, combos))
    sus_multi.sort(key=lambda x: (-x[1], -x[2], x[0]))

    integrity_hits = [r for r in results if r.integrity_issues]
    note_hits = [r for r in results if r.integrity_notes]

    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S %z")
    out: list[str] = []
    A = out.append

    A(f"# Harvest Index — {now}")
    A("")

    if diff_lines:
        out.extend(diff_lines)
        A("")

    A("## Overview")
    A("")
    A(f"- **Diag root:** `{diag_root}`")
    A(f"- **Harvest:**   `{harvest_root}`")
    A(f"- **Branches:**  {_branch_list({r.branch for r in results})}")
    A(
        f"- **Builds:** {len(results)} — "
        f"❗{by_status['failed']} failed, "
        f"🔍{by_status['suspicious']} suspicious, "
        f"⚠{by_status['warnings']} warn, "
        f"✅{by_status['clean']} clean, "
        f"🚫{by_status['not-built']} not-built"
    )
    A(
        f"- **Warning signatures:** {len(sig_map)} total — "
        f"{len(multi)} across multiple builds, "
        f"{len(single)} unique to one build"
    )
    A(
        f"- **Suspicious signatures:** {len(sus_map)}  ·  "
        f"**integrity issues:** {len(integrity_hits)} builds  ·  "
        f"**integrity notes:** {len(note_hits)} builds"
    )
    A("")

    A("## Legend")
    A("")
    A("| Symbol | Status | Meaning |")
    A("|:------:|--------|---------|")
    A("| ❗ | failed     | make.log contains real errors — **blocker** |")
    A("| 🔍 | suspicious | no errors, but suspicious lines or integrity issues |")
    A("| ⚠  | warnings   | built, no errors, non-noise warnings to review |")
    A("| ✅ | clean      | built, no errors, only known noise |")
    A("| 🚫 | not-built  | no make.log at all |")
    A("")
    A("Per-build detail lives in the harvest tree, one directory per kernel: "
      "`00-header.txt`, `01-errors.txt`, `02-warnings.txt`, `03-noise.txt`, "
      "`04-suspicious.txt`, `summary.txt`.")
    A("")

    A("## Status table")
    A("")
    A("| # | Branch | Variant | Kernel | Driver | Status | Err | Clean (uniq/total) | Susp | Noise | Integ |")
    A("|---|--------|---------|--------|--------|:------:|----:|-------------------:|-----:|------:|:-----:|")
    sorted_results = sorted(
        results,
        key=lambda r: (r.branch, r.variant, r.kernel_ver or r.build_name),
    )
    for i, r in enumerate(sorted_results, 1):
        sym = STATUS_SYMBOL.get(r.status, "?")
        kernel = r.kernel_ver or r.build_name
        driver = r.driver_ver or "-"
        integ = "!" if r.integrity_issues else ("·" if r.integrity_notes else "")
        A(
            f"| {i} | {r.branch} | {r.variant} | {kernel} | {driver} | "
            f"{sym} {r.status} | {r.err_count} | "
            f"{r.clean_uniq} / {r.clean_total} | "
            f"{r.suspicious_total} | {r.noise_total} | {integ} |"
        )
    A("")

    if integrity_hits:
        A("## 🧱 Integrity issues")
        A("")
        A("Structural problems detected between the **log** and the **build "
          "tree** — these likely indicate a silent failure.")
        A("")
        for r in integrity_hits:
            ident = f"{r.branch} / {r.variant} / {r.kernel_ver or r.build_name}"
            A(f"### {ident}")
            A("")
            A(f"Path: `{r.out_dir.relative_to(harvest_root)}`  ·  "
              f"modules on disk: {len(r.modules_on_disk)} "
              f"[{', '.join(r.modules_on_disk) if r.modules_on_disk else '—'}]  ·  "
              f"log LD [M]: {sorted(r.log_ld_modules) or '—'}")
            A("")
            for issue in r.integrity_issues:
                A(f"- {issue}")
            A("")

    if note_hits:
        A("## 📝 Integrity notes")
        A("")
        A("Non-critical observations. Not flagged as suspicious, but worth "
          "knowing when reading a build's `summary.txt`.")
        A("")
        for r in note_hits:
            ident = f"{r.branch} / {r.variant} / {r.kernel_ver or r.build_name}"
            A(f"- **{ident}**")
            for note in r.integrity_notes:
                A(f"  - {note}")
        A("")

    failed = [r for r in results if r.status == "failed"]
    if failed:
        A("## ❗ Failures — fix these first")
        A("")
        A("Full error list in each build's `01-errors.txt`. Excerpt below.")
        A("")
        for r in failed:
            A(f"### {r.branch} / {r.variant} / {r.kernel_ver or r.build_name} "
              f"— {r.driver_ver or '?'}  ({r.err_count} errors)")
            A("")
            A(f"Path: `{r.out_dir.relative_to(harvest_root)}`")
            A("")
            A("```")
            for ln in r.error_excerpt[:15]:
                A(ln)
            A("```")
            A("")

    if sus_multi:
        A("## 🔍 Suspicious signatures")
        A("")
        A("Lines that are **not** errors and **not** warnings, but contain "
          "keywords that often indicate real problems (missing files, "
          "permissions, OOM, crashes, missing deps).")
        A("")
        A("| # | Builds | Hits | Signature | Branches |")
        A("|---|-------:|-----:|-----------|----------|")
        for i, (sig, builds, hits, combos) in enumerate(sus_multi, 1):
            A(f"| {i} | {builds} | {hits} | `{sig}` | {', '.join(sorted(combos))} |")
        A("")
        A("<details><summary>Context excerpts (first few hits per signature)</summary>")
        A("")
        for sig, builds, hits, combos in sus_multi[:10]:
            A(f"**`{sig}`**")
            A("")
            A("```")
            shown = 0
            for r in results:
                if sig in r.suspicious_signatures:
                    for ln in r.suspicious_excerpt:
                        A(f"[{r.branch}/{r.variant}/{r.kernel_ver or r.build_name}] {ln}")
                        shown += 1
                        if shown >= 5:
                            break
                if shown >= 5:
                    break
            A("```")
            A("")
        A("</details>")
        A("")

    A("## 🔁 Cross-build warning signatures")
    A("")
    A("Warnings appearing in **more than one build**. "
      "Fixing the top signature fixes the most builds at once.")
    A("")
    if multi:
        A("| # | Builds | Hits | Signature | Branches |")
        A("|---|-------:|-----:|-----------|----------|")
        for i, (sig, builds, hits, combos) in enumerate(multi, 1):
            A(f"| {i} | {builds} | {hits} | `{sig}` | {', '.join(sorted(combos))} |")
    else:
        A("_No cross-build signatures._")
    A("")

    A("## 🧩 Unique to one build")
    A("")
    A("Warnings in exactly **one** build. Usually kernel- or config-specific.")
    A("")
    if single:
        A("| Build | Hits | Signature |")
        A("|-------|-----:|-----------|")
        for sig, r, hits in single:
            ident = f"{r.branch}/{r.variant}/{r.kernel_ver or r.build_name}"
            A(f"| {ident} | {hits} | `{sig}` |")
    else:
        A("_No unique-to-one-build warnings._")
    A("")

    not_built = [r for r in results if r.status == "not-built"]
    if not_built:
        A("## 🚫 Not built (no make.log)")
        A("")
        for r in not_built:
            A(f"- `{r.branch} / {r.variant} / {r.build_name}`")
        A("")

    A("---")
    A("_End of index. Per-build detail files live in the harvest tree._")

    idx_path.write_text("\n".join(out) + "\n")


# ---------------------------------------------------------------------------
# History persistence
# ---------------------------------------------------------------------------

def _save_snapshot(
    history_root: Path,
    run_ts: str,
    state: dict,
    index_text: str,
) -> Path:
    snap_dir = history_root / run_ts
    snap_dir.mkdir(parents=True, exist_ok=True)
    (snap_dir / "state.json").write_text(
        json.dumps(state, indent=2, sort_keys=True)
    )
    (snap_dir / "INDEX.md").write_text(index_text)
    return snap_dir


def _prune_snapshots(history_root: Path, keep: int) -> int:
    if keep <= 0:
        return 0
    snaps = sorted(
        (d for d in history_root.iterdir() if d.is_dir()),
        reverse=True,
    )
    removed = 0
    for old in snaps[keep:]:
        try:
            for f in old.iterdir():
                f.unlink()
            old.rmdir()
            removed += 1
        except OSError:
            pass
    return removed


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _log(msg: str, quiet: bool) -> None:
    if not quiet:
        print(f"[harvest] {msg}", file=sys.stderr)


def _warn(msg: str) -> None:
    print(f"[harvest][warn] {msg}", file=sys.stderr)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="harvest-nvidia-logs",
        description="Collect and noise-filter nvidia driver make.logs "
                    "across multiple kernel builds.",
    )
    p.add_argument(
        "-d", "--diag-root", type=Path,
        default=Path(os.environ.get("DIAG_ROOT", str(DEFAULT_DIAG_ROOT))),
        help="Base diag directory (default: $HOME/diag, env DIAG_ROOT)",
    )
    p.add_argument(
        "-o", "--harvest-dir", type=Path, default=None,
        help="Output directory (default: <diag-root>/harvest)",
    )
    p.add_argument(
        "-n", "--header-lines", type=int, default=DEFAULT_HEADER_LINES,
        help=f"Lines from top of make.log to save (default: {DEFAULT_HEADER_LINES})",
    )
    p.add_argument(
        "-q", "--quiet", action="store_true",
        help="Suppress progress output on stderr",
    )
    p.add_argument(
        "--diff", action="store_true",
        help="Prepend a 'Changes since last run' section to INDEX.md "
             "by comparing against the most recent history snapshot.",
    )
    p.add_argument(
        "--changelog", type=Path, default=None,
        help="Append the diff section (newest first) to this markdown "
             "file. Only takes effect with --diff. Safe to run repeatedly.",
    )
    p.add_argument(
        "--history-keep", type=int, default=DEFAULT_HISTORY_KEEP,
        help=f"Keep only the N most recent snapshots in history/ "
             f"(default: {DEFAULT_HISTORY_KEEP}, 0 = keep all).",
    )
    p.add_argument(
        "--version", action="version",
        version=f"%(prog)s {__version__}",
    )
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    diag_root = args.diag_root.expanduser().resolve()
    harvest_root = (
        args.harvest_dir or (diag_root / DEFAULT_HARVEST_SUBDIR)
    ).expanduser().resolve()

    if not diag_root.is_dir():
        _warn(f"diag root does not exist: {diag_root}")
        return 1

    harvest_root.mkdir(parents=True, exist_ok=True)
    _log(f"DIAG_ROOT={diag_root}", args.quiet)
    _log(f"HARVEST_DIR={harvest_root}", args.quiet)

    builds = find_builds(diag_root)
    if not builds:
        _warn(f"no nvidia-* branch directory found under {diag_root}")
        return 0

    results: list[BuildResult] = []
    for branch, variant, build_dir in builds:
        try:
            r = process_build(
                branch, variant, build_dir,
                harvest_root, args.header_lines, args.quiet,
            )
            results.append(r)
        except Exception as e:
            _warn(f"failed to process {build_dir}: {e}")

    history_root = harvest_root / "history"
    history_root.mkdir(parents=True, exist_ok=True)

    run_ts = datetime.now().strftime("%Y-%m-%dT%H-%M-%S")
    pretty_ts = datetime.now().strftime("%Y-%m-%d %H:%M")
    curr_state = _snapshot_state(results, run_ts)

    diff_lines: list[str] | None = None
    if args.diff:
        prev = _latest_snapshot(history_root)
        if prev is None:
            _log("no previous snapshot found — skipping diff", args.quiet)
        else:
            _, prev_state = prev
            diff = _compute_diff(prev_state, curr_state)
            diff_lines = render_diff_section(diff)
            _log(
                f"diff vs {diff['prev_timestamp']}: "
                f"{len(diff['resolved_sigs'])} resolved, "
                f"{len(diff['new_sigs'])} new, "
                f"{len(diff['status_changes'])} status changes",
                args.quiet,
            )

            if args.changelog and diff_lines:
                append_changelog(args.changelog, diff_lines, pretty_ts)
                _log(f"changelog: {args.changelog}", args.quiet)

    generate_index(results, diag_root, harvest_root, diff_lines)

    index_text = (harvest_root / "INDEX.md").read_text()
    _save_snapshot(history_root, run_ts, curr_state, index_text)

    if args.history_keep > 0:
        pruned = _prune_snapshots(history_root, args.history_keep)
        if pruned:
            _log(f"pruned {pruned} old snapshot(s)", args.quiet)

    _log(f"Index: {harvest_root / 'INDEX.md'}", args.quiet)
    return 0


if __name__ == "__main__":
    sys.exit(main())